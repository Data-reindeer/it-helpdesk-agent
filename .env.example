# Copy this file to .env and enter your own API key locally.
# The key is intentionally blank. Do not commit or share the populated .env.
OPENAI_API_KEY=
# OpenAI-compatible Responses API base; the adapter appends /responses.
# This default endpoint/model pair was used for evaluation; replace both if needed.
OPENAI_BASE_URL=https://api.anzhelyu.com/v1
OPENAI_MODEL=gpt-6.1-sol
AGENT_MODE=openai
HELPDESK_DB=var/helpdesk.sqlite3
# Optional operator-supplied USD rates per million tokens.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
